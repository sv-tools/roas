{% endif %}{% if support.decimal %}
// Decimal is a number on the wire, held exactly: its significant digits
// times ten to its exponent, with at most DecimalMaxDigits significant
// digits and an int32 exponent. It is decoded from the number's own JSON
// token, so nothing is rounded, and written in its shortest form, so 1.50
// is written back as 1.5. A number past those limits is refused at decode
// rather than rounded. The zero value is zero.
type Decimal struct {
	// Canonical: digits has no leading or trailing zero, and is empty for
	// zero, which is never negative.
	negative bool
	digits   string
	exponent int32
}

// DecimalMaxDigits is the most significant digits a Decimal holds.
const DecimalMaxDigits = 38

// ParseDecimal reads a number as JSON writes one: -12.5, 1e-3, 0.10.
func ParseDecimal(text string) (Decimal, error) {
	x, ok := decimalToken(text)
	if !ok {
		return Decimal{}, fmt.Errorf("%q is not a number with at most 38 significant digits and an exponent in the int32 range", text)
	}
	return x, nil
}

// decimalToken parses a JSON number token, refusing anything else and
// anything past the limits a Decimal holds.
func decimalToken(text string) (Decimal, bool) {
	negative := false
	if len(text) > 0 && text[0] == '-' {
		negative, text = true, text[1:]
	}
	mantissa, exponent := text, int64(0)
	for i := 0; i < len(text); i++ {
		if text[i] != 'e' && text[i] != 'E' {
			continue
		}
		mantissa = text[:i]
		power := text[i+1:]
		negativeExponent := false
		if len(power) > 0 && (power[0] == '+' || power[0] == '-') {
			negativeExponent, power = power[0] == '-', power[1:]
		}
		if len(power) == 0 || !decimalDigits(power) {
			return Decimal{}, false
		}
		for j := 0; j < len(power); j++ {
			// Saturate: zero is still zero, and anything else is out of
			// range either way.
			if exponent < 1<<40 {
				exponent = exponent*10 + int64(power[j]-'0')
			}
		}
		if negativeExponent {
			exponent = -exponent
		}
		break
	}
	whole, fraction := mantissa, ""
	for i := 0; i < len(mantissa); i++ {
		if mantissa[i] == '.' {
			whole, fraction = mantissa[:i], mantissa[i+1:]
			break
		}
	}
	if len(whole) == 0 || !decimalDigits(whole) || !decimalDigits(fraction) {
		return Decimal{}, false
	}
	all := whole + fraction
	start, end := 0, len(all)
	for start < end && all[start] == '0' {
		start++
	}
	for end > start && all[end-1] == '0' {
		end--
	}
	if start == end {
		return Decimal{}, true
	}
	if end-start > DecimalMaxDigits {
		return Decimal{}, false
	}
	exponent += int64(len(all)-end) - int64(len(fraction))
	if exponent < -1<<31 || exponent > 1<<31-1 {
		return Decimal{}, false
	}
	return Decimal{negative: negative, digits: all[start:end], exponent: int32(exponent)}, true
}

func decimalDigits(text string) bool {
	for i := 0; i < len(text); i++ {
		if text[i] < '0' || text[i] > '9' {
			return false
		}
	}
	return true
}

// String writes the shortest JSON number for x: plain unless its point
// lies far from its digits, as JavaScript writes numbers.
func (x Decimal) String() string {
	if x.digits == "" {
		return "0"
	}
	var b []byte
	if x.negative {
		b = append(b, '-')
	}
	count, power := int64(len(x.digits)), int64(x.exponent)
	// The power of ten of the leading digit.
	leading := count - 1 + power
	switch {
	case leading < -7 || leading >= 21:
		b = append(b, x.digits[0])
		if count > 1 {
			b = append(b, '.')
			b = append(b, x.digits[1:]...)
		}
		b = fmt.Appendf(b, "e%d", leading)
	case power >= 0:
		b = append(b, x.digits...)
		for i := int64(0); i < power; i++ {
			b = append(b, '0')
		}
	case count+power > 0:
		b = append(b, x.digits[:count+power]...)
		b = append(b, '.')
		b = append(b, x.digits[count+power:]...)
	default:
		b = append(b, '0', '.')
		for i := int64(0); i < -(count + power); i++ {
			b = append(b, '0')
		}
		b = append(b, x.digits...)
	}
	return string(b)
}

// Float64 is the nearest float64 to x.
func (x Decimal) Float64() float64 {
	f, _ := strconv.ParseFloat(x.String(), 64)
	return f
}

func (x Decimal) sign() int {
	switch {
	case x.digits == "":
		return 0
	case x.negative:
		return -1
	default:
		return 1
	}
}

// Cmp compares x and y exactly: -1 when x is less, 0 when they are equal,
// and +1 when x is greater.
func (x Decimal) Cmp(y Decimal) int {
	sx, sy := x.sign(), y.sign()
	if sx != sy {
		if sx < sy {
			return -1
		}
		return 1
	}
	if sx == 0 {
		return 0
	}
	c := 0
	lx := int64(len(x.digits)) + int64(x.exponent)
	ly := int64(len(y.digits)) + int64(y.exponent)
	switch {
	case lx < ly:
		c = -1
	case lx > ly:
		c = 1
	default:
		// The same leading power of ten: digit by digit, a missing digit
		// read as a zero.
		for i := 0; c == 0 && (i < len(x.digits) || i < len(y.digits)); i++ {
			dx, dy := byte('0'), byte('0')
			if i < len(x.digits) {
				dx = x.digits[i]
			}
			if i < len(y.digits) {
				dy = y.digits[i]
			}
			if dx < dy {
				c = -1
			} else if dx > dy {
				c = 1
			}
		}
	}
	if x.negative {
		return -c
	}
	return c
}

// IsMultipleOf reports whether x is an integer multiple of divisor,
// decided exactly.
func (x Decimal) IsMultipleOf(divisor Decimal) bool {
	if x.digits == "" {
		return true
	}
	if divisor.digits == "" {
		return false
	}
	// A canonical mantissa ends in no zero, so it is no multiple of a
	// mantissa scaled by a further power of ten.
	shift := int64(x.exponent) - int64(divisor.exponent)
	if shift < 0 {
		return false
	}
	// m times 10^shift is a multiple of d exactly when m is one of d with
	// the twos and fives 10^shift supplies taken out.
	d, _ := new(big.Int).SetString(divisor.digits, 10)
	quotient, remainder := new(big.Int), new(big.Int)
	for _, prime := range []*big.Int{big.NewInt(2), big.NewInt(5)} {
		for taken := int64(0); taken < shift; taken++ {
			quotient.QuoRem(d, prime, remainder)
			if remainder.Sign() != 0 {
				break
			}
			d.Set(quotient)
		}
	}
	m, _ := new(big.Int).SetString(x.digits, 10)
	return remainder.Rem(m, d).Sign() == 0
}

func (x Decimal) MarshalJSONTo(e *jsontext.Encoder) error {
	return e.WriteValue(jsontext.Value(x.String()))
}

func (x *Decimal) UnmarshalJSONFrom(d *jsontext.Decoder) error {
	raw, err := d.ReadValue()
	if err != nil {
		return err
	}
	v, ok := decimalToken(string(raw))
	if raw.Kind() != '0' || !ok {
		return fmt.Errorf("%s is not a number with at most 38 significant digits and an exponent in the int32 range", raw)
	}
	*x = v
	return nil
}
