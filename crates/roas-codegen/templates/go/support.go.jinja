// Int64 is an integer on the wire: any JSON number that denotes one,
// decoded exactly, held as an int64.
type Int64 int64

func (n *Int64) UnmarshalJSONFrom(d *jsontext.Decoder) error {
	raw, err := d.ReadValue()
	if err != nil {
		return err
	}
	v, ok := integerToken(raw, 1<<63-1)
	if !ok {
		return fmt.Errorf("%s is not an integer in the int64 range", raw)
	}
	*n = Int64(v)
	return nil
}
