{% if support.patterns %}// patterns holds each pattern compiled, or nil when it is too large to.
var patterns sync.Map

// matchPattern says whether s matches the regex src, compiled once, and
// whether it could be compiled at all.
func matchPattern(src, s string) (matched, compiled bool) {
	re, ok := patterns.Load(src)
	if !ok {
		c, err := regexp.Compile(src)
		if err != nil {
			c = nil
		}
		re, _ = patterns.LoadOrStore(src, c)
	}
	if c := re.(*regexp.Regexp); c != nil {
		return c.MatchString(s), true
	}
	return false, false
}

{% if support.member_patterns %}// memberMatches says whether a member name matches one of the patterns
// of patternProperties. A pattern that does not compile lets every name
// in, rather than refuse one it allows.
func memberMatches(name string, srcs ...string) bool {
	for _, src := range srcs {
		if matched, compiled := matchPattern(src, name); matched || !compiled {
			return true
		}
	}
	return false
}

{% endif %}{% endif %}{% if support.validation %}
// wideNumber says whether raw has a number a generated type may fail to
// decode for its range rather than its value: a whole number from intLimit
// on, one past the 32-bit float range when narrow holds, or one past
// float64 — or nests deeper than the decoder reads. A union branch that
// fails to decode such a value proves no mismatch.
func wideNumber(raw []byte, intLimit float64, narrow bool) bool {
	inString, depth := false, 0
	for i := 0; i < len(raw); i++ {
		b := raw[i]
		if inString {
			switch b {
			case '\\':
				i++
			case '"':
				inString = false
			}
			continue
		}
		if b == '"' {
			inString = true
			continue
		}
		// Nested past the decoder's limit, a branch fails to decode for
		// the decoder, not the schema.
		if b == '[' || b == '{' {
			depth++
			if depth > 9000 {
				return true
			}
			continue
		}
		if b == ']' || b == '}' {
			depth--
			continue
		}
		if b == '-' || (b >= '0' && b <= '9') {
			start := i
			for i < len(raw) && (raw[i] >= '0' && raw[i] <= '9' || raw[i] == '.' || raw[i] == 'e' || raw[i] == 'E' || raw[i] == '+' || raw[i] == '-') {
				i++
			}
			var f float64
			if json.Unmarshal(raw[start:i], &f) != nil || math.IsInf(f, 0) {
				return true
			}
			if (f == math.Trunc(f) && math.Abs(f) >= intLimit) || (narrow && math.Abs(f) > math.MaxFloat32) {
				return true
			}
			i--
		}
	}
	return false
}

// FindingKind says what a finding is.
type FindingKind int

const (
	// Violation: the value breaks a constraint.
	Violation FindingKind = iota
	// Unevaluated: a constraint could not be checked; the message says
	// which and why.
	Unevaluated
)

// Finding is one thing validation found, at an RFC 6901 JSON Pointer into
// the value.
type Finding struct {
	Pointer string
	Kind    FindingKind
	Message string
}

// ValidationReport collects every constraint a value breaks and every one
// it could not check, rather than stopping at the first.
type ValidationReport struct {
	Findings []Finding
	// depth counts the generated types the walk is inside: a raw holder
	// decodes afresh, so nothing else bounds a recursive value.
	depth int
	// spent counts the bytes decoded for branches, against a budget: each
	// branch decodes its holder's raw value again, and nested unions would
	// otherwise multiply the work.
	spent int
	// stopped: the budget ran out, and the rest went unchecked.
	stopped bool
}

// nested is a report for one branch, as deep and as spent as r. Once the
// budget is spent, the branch goes unchecked and says so.
func (r *ValidationReport) nested(pointer string) *ValidationReport {
	branch := &ValidationReport{depth: r.depth, spent: r.spent, stopped: r.stopped}
	if r.stopped {
		branch.unevaluated(pointer, "too many branches to validate")
	}
	return branch
}

// resume takes back what a branch spent; a branch that ran out stops r
// too, and says so here.
func (r *ValidationReport) resume(pointer string, branch *ValidationReport) {
	r.spent = branch.spent
	if branch.stopped && !r.stopped {
		r.stopped = true
		r.unevaluated(pointer, "too many branches to validate")
	}
}

// enter steps into a generated type, charging what its branches will
// decode (cost, in bytes); past the depth limit or the budget, the rest is
// reported unevaluated instead of walked.
func (r *ValidationReport) enter(pointer string, cost int) bool {
	if r.stopped {
		return false
	}
	if r.depth >= 256 {
		r.unevaluated(pointer, "nested too deep to validate")
		return false
	}
	r.spent += cost
	if r.spent > 64<<20 {
		r.stopped = true
		r.unevaluated(pointer, "too many branches to validate")
		return false
	}
	r.depth++
	return true
}

// IsValid is true only when nothing was found, so a constraint that could
// not be checked is never mistaken for one that passed.
func (r *ValidationReport) IsValid() bool { return len(r.Findings) == 0 }

// Violations are the findings of constraints the value breaks.
func (r *ValidationReport) Violations() []Finding { return r.of(Violation) }

// Unchecked are the findings of constraints that could not be checked.
func (r *ValidationReport) Unchecked() []Finding { return r.of(Unevaluated) }

func (r *ValidationReport) of(kind FindingKind) []Finding {
	var out []Finding
	for _, f := range r.Findings {
		if f.Kind == kind {
			out = append(out, f)
		}
	}
	return out
}

func (r *ValidationReport) violation(pointer, message string) {
	r.Findings = append(r.Findings, Finding{Pointer: pointer, Kind: Violation, Message: message})
}

func (r *ValidationReport) unevaluated(pointer, message string) {
	r.Findings = append(r.Findings, Finding{Pointer: pointer, Kind: Unevaluated, Message: message})
}

// Validator checks a value against the constraints its schema declares
// that its type cannot express. Every generated type implements it.
type Validator interface {
	Validate() *ValidationReport
}

// childPointer extends pointer by one RFC 6901 reference token.
func childPointer(pointer, token string) string {
	escaped := make([]byte, 0, len(token))
	for i := 0; i < len(token); i++ {
		switch token[i] {
		case '~':
			escaped = append(escaped, '~', '0')
		case '/':
			escaped = append(escaped, '~', '1')
		default:
			escaped = append(escaped, token[i])
		}
	}
	return pointer + "/" + string(escaped)
}
