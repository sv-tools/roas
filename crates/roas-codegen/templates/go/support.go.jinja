// decodeOptions turns a JSON null into an error wherever the Go type
// would otherwise store its zero value, since the schema does not allow
// null there. A substituted type is then decoded by its own rules alone,
// and unmarshalers a caller passes do not reach into generated types.
{% if support.refuse_null or support.refuse_null_isolated or support.isolated %}var decodeOptions = json.WithUnmarshalers(json.JoinUnmarshalers(
{% for t in support.refuse_null %}	json.UnmarshalFromFunc(func(d *jsontext.Decoder, _ *{{ t }}) error { return refuseNull(d, {{ t | tojson }}) }),
{% endfor %}{% for t in support.refuse_null_isolated %}	json.UnmarshalFromFunc(func(d *jsontext.Decoder, v *{{ t }}) error {
		if err := refuseNull(d, {{ t | tojson }}); err != errors.ErrUnsupported {
			return err
		}
		return json.UnmarshalDecode(d, v, noUnmarshalers)
	}),
{% endfor %}{% for t in support.isolated %}	json.UnmarshalFromFunc(func(d *jsontext.Decoder, v *{{ t }}) error {
		return json.UnmarshalDecode(d, v, noUnmarshalers)
	}),
{% endfor %}))
{% else %}var decodeOptions = json.JoinOptions()
{% endif %}{% if support.refuse_null_isolated or support.isolated %}
// noUnmarshalers drops every unmarshaler for a substituted type. It holds
// one for a type that never occurs: json/v2 dereferences the nil set
// json.WithUnmarshalers(nil) would store when it decodes into an any.
var noUnmarshalers = json.WithUnmarshalers(json.UnmarshalFromFunc(func(*jsontext.Decoder, *isolatedNone) error {
	return errors.ErrUnsupported
}))

type isolatedNone struct{}
{% endif %}
func refuseNull(d *jsontext.Decoder, typ string) error {
	if d.PeekKind() == 'n' {
		// Read first: a malformed literal is a syntax error, not a null.
		if _, err := d.ReadToken(); err != nil {
			return err
		}
		return fmt.Errorf("null is not a valid %s here", typ)
	}
	return errors.ErrUnsupported
}

{% if support.tagged %}
// readTag reads a tagged union's discriminator, which must be a string
// member of an object.
func readTag(raw jsontext.Value, typ, tag string) (string, error) {
	if raw.Kind() != '{' {
		return "", fmt.Errorf("%s: want a JSON object, got %s", typ, raw)
	}
	var members map[string]jsontext.Value
	if err := json.Unmarshal(raw, &members); err != nil {
		return "", err
	}
	member, ok := members[tag]
	if !ok {
		return "", fmt.Errorf("%s: missing discriminator %q", typ, tag)
	}
	var value string
	if member.Kind() != '"' || json.Unmarshal(member, &value) != nil {
		return "", fmt.Errorf("%s: discriminator %q must be a string, got %s", typ, tag, member)
	}
	return value, nil
}
{% endif %}{% if support.nullable %}
// Nullable is a member that may be null. Set reports whether it is
// present at all; Value is nil for an explicit null. An optional and
// nullable member has three states — absent, null, a value — and this
// keeps all three: omitzero leaves out only the absent one.
type Nullable[T any] struct {
	Set   bool
	Value *T
}

// IsZero reports an absent member, which omitzero leaves out.
func (n Nullable[T]) IsZero() bool { return !n.Set }

func (n Nullable[T]) MarshalJSONTo(e *jsontext.Encoder) error {
	if n.Value == nil {
		return e.WriteToken(jsontext.Null)
	}
	return json.MarshalEncode(e, n.Value)
}

func (n *Nullable[T]) UnmarshalJSONFrom(d *jsontext.Decoder) error {
	*n = Nullable[T]{Set: true}
	if d.PeekKind() == 'n' {
		_, err := d.ReadToken()
		return err
	}
	var v T
	if err := json.UnmarshalDecode(d, &v, decodeOptions); err != nil {
		return err
	}
	n.Value = &v
	return nil
}
