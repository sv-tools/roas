// integerToken reads a JSON number token as the integer it denotes, if
// it denotes one in [-limit-1, limit]: 1.0 and 1e0 are integers, 1.5 is
// not, and the digits are read exactly rather than through a float. The
// work is bounded by the token's length, whatever its exponent.
func integerToken(raw jsontext.Value, limit uint64) (int64, bool) {
	if raw.Kind() != '0' {
		return 0, false
	}
	text := string(raw)
	negative := text[0] == '-'
	if negative {
		text = text[1:]
	}
	mantissa, exponent := text, int64(0)
	for i := 0; i < len(text); i++ {
		if text[i] != 'e' && text[i] != 'E' {
			continue
		}
		mantissa = text[:i]
		digits := text[i+1:]
		negativeExponent := false
		if digits[0] == '+' || digits[0] == '-' {
			negativeExponent = digits[0] == '-'
			digits = digits[1:]
		}
		for j := 0; j < len(digits); j++ {
			// Saturate: zero is still an integer, and anything else is
			// out of range either way.
			if exponent < 1<<30 {
				exponent = exponent*10 + int64(digits[j]-'0')
			}
		}
		if negativeExponent {
			exponent = -exponent
		}
		break
	}
	whole, fraction := mantissa, ""
	for i := 0; i < len(mantissa); i++ {
		if mantissa[i] == '.' {
			whole, fraction = mantissa[:i], mantissa[i+1:]
			break
		}
	}
	digits := whole + fraction
	zero := true
	for i := 0; i < len(digits); i++ {
		if digits[i] != '0' {
			zero = false
			break
		}
	}
	if zero {
		return 0, true
	}
	scale := exponent - int64(len(fraction))
	for ; scale < 0; scale++ {
		if digits[len(digits)-1] != '0' {
			return 0, false
		}
		digits = digits[:len(digits)-1]
	}
	// A non-zero value scaled past 19 digits is beyond any int64.
	if scale > 19 {
		return 0, false
	}
	ceiling := limit
	if negative {
		ceiling = limit + 1
	}
	var magnitude uint64
	for i := 0; i < len(digits); i++ {
		digit := uint64(digits[i] - '0')
		if magnitude > (ceiling-digit)/10 {
			return 0, false
		}
		magnitude = magnitude*10 + digit
	}
	for ; scale > 0; scale-- {
		if magnitude > ceiling/10 {
			return 0, false
		}
		magnitude *= 10
	}
	if negative {
		return -int64(magnitude-1) - 1, true
	}
	return int64(magnitude), true
}
