{% if support.int64 or support.int32 %}/// Parse a JSON number token as the integer it denotes, if it is one:
/// `1.0` and `1e0` are integers, `1.5` is not, and the digits are read
/// exactly rather than through a float.
fn integer_token(text: &str) -> Option<i128> {
    let text = text.trim();
    let (negative, rest) = match text.strip_prefix('-') {
        Some(rest) => (true, rest),
        None => (false, text),
    };
    let (mantissa, exponent) = match rest.split_once(['e', 'E']) {
        Some((m, e)) => {
            // Saturate an exponent too long for `i32`: zero is still an
            // integer, and anything else is out of range either way.
            let (negative, digits) = match e.strip_prefix('-') {
                Some(d) => (true, d),
                None => (false, e.strip_prefix('+').unwrap_or(e)),
            };
            if digits.is_empty() || !digits.bytes().all(|b| b.is_ascii_digit()) {
                return None;
            }
            let magnitude = digits.parse::<i32>().unwrap_or(i32::MAX);
            (m, if negative { -magnitude } else { magnitude })
        }
        None => (rest, 0),
    };
    let (int_part, frac_part) = match mantissa.split_once('.') {
        Some((i, f)) => (i, f),
        None => (mantissa, ""),
    };
    if int_part.is_empty() || !int_part.bytes().all(|b| b.is_ascii_digit()) || !frac_part.bytes().all(|b| b.is_ascii_digit()) {
        return None;
    }
    let mut digits = format!("{int_part}{frac_part}");
    // Zero is an integer whatever its exponent, and handling it first
    // keeps a huge exponent on it from costing anything.
    if digits.bytes().all(|b| b == b'0') {
        return Some(0);
    }
    let mut scale = exponent.checked_sub(i32::try_from(frac_part.len()).ok()?)?;
    // A non-zero value scaled past 38 digits overflows `i128` anyway.
    if scale > 38 {
        return None;
    }
    while scale < 0 {
        match digits.pop() {
            Some('0') => scale += 1,
            _ => return None,
        }
    }
    let mut value: i128 = digits.parse().ok()?;
    for _ in 0..scale {
        value = value.checked_mul(10)?;
    }
    Some(if negative { -value } else { value })
}

{% endif %}{% if support.int64 %}/// An `integer` on the wire: any JSON number token that denotes an
/// integer, decoded exactly, held as an `i64`.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord, Default, Serialize)]
#[serde(transparent)]
pub struct Int64(pub i64);

impl<'de> Deserialize<'de> for Int64 {
    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
        let raw: Box<serde_json::value::RawValue> = Deserialize::deserialize(deserializer)?;
        integer_token(raw.get())
            .and_then(|v| i64::try_from(v).ok())
            .map(Int64)
            .ok_or_else(|| serde::de::Error::custom(format!("`{}` is not an integer in the int64 range", raw.get())))
    }
}

impl From<i64> for Int64 {
    fn from(value: i64) -> Self {
        Int64(value)
    }
}

impl From<Int64> for i64 {
    fn from(value: Int64) -> Self {
        value.0
    }
}

{% endif %}{% if support.int32 %}/// An `integer` with `format: int32` on the wire, decoded exactly.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord, Default, Serialize)]
#[serde(transparent)]
pub struct Int32(pub i32);

impl<'de> Deserialize<'de> for Int32 {
    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
        let raw: Box<serde_json::value::RawValue> = Deserialize::deserialize(deserializer)?;
        integer_token(raw.get())
            .and_then(|v| i32::try_from(v).ok())
            .map(Int32)
            .ok_or_else(|| serde::de::Error::custom(format!("`{}` is not an integer in the int32 range", raw.get())))
    }
}

impl From<i32> for Int32 {
    fn from(value: i32) -> Self {
        Int32(value)
    }
}

impl From<Int32> for i32 {
    fn from(value: Int32) -> Self {
        value.0
    }
}

{% endif %}{% if support.double_option %}/// Optional and nullable: absent, `null` and present are three states.
mod double_option {
    pub fn deserialize<'de, T, D>(deserializer: D) -> Result<Option<Option<T>>, D::Error>
    where
        T: serde::Deserialize<'de>,
        D: serde::Deserializer<'de>,
    {
        Ok(Some(<Option<T> as serde::Deserialize>::deserialize(deserializer)?))
    }
}

{% endif %}{% if support.reject_null %}/// Optional but not nullable: an explicit `null` is rejected.
mod reject_null {
    pub fn deserialize<'de, T, D>(deserializer: D) -> Result<Option<T>, D::Error>
    where
        T: serde::Deserialize<'de>,
        D: serde::Deserializer<'de>,
    {
        <T as serde::Deserialize>::deserialize(deserializer).map(Some)
    }
}

{% endif %}{% if support.require_present %}/// Required and nullable: `null` is accepted, a missing member is not.
mod require_present {
    pub fn deserialize<'de, T, D>(deserializer: D) -> Result<Option<T>, D::Error>
    where
        T: serde::Deserialize<'de>,
        D: serde::Deserializer<'de>,
    {
        <Option<T> as serde::Deserialize>::deserialize(deserializer)
    }
}

{% endif %}{% if support.validation %}/// What [`Validate`] found: every constraint a value breaks, and every one
/// it could not check. Findings collect rather than stop at the first.
#[derive(Debug, Clone, Default, PartialEq, Eq)]
pub struct ValidationReport {
    pub findings: Vec<Finding>,
}

/// One finding, at an RFC 6901 JSON Pointer into the value.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Finding {
    pub pointer: String,
    pub kind: FindingKind,
    pub message: String,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum FindingKind {
    /// The value breaks a constraint.
    Violation,
    /// A constraint could not be checked; the message says which and why.
    Unevaluated,
}

impl ValidationReport {
    /// True only when nothing was found, so a constraint that could not be
    /// checked is never mistaken for one that passed.
    pub fn is_valid(&self) -> bool {
        self.findings.is_empty()
    }

    pub fn violations(&self) -> impl Iterator<Item = &Finding> {
        self.findings.iter().filter(|f| f.kind == FindingKind::Violation)
    }

    pub fn unchecked(&self) -> impl Iterator<Item = &Finding> {
        self.findings.iter().filter(|f| f.kind == FindingKind::Unevaluated)
    }

    // Unused when no type has a check of that kind.
    #[allow(dead_code)]
    fn violation(&mut self, pointer: &str, message: impl Into<String>) {
        self.findings.push(Finding { pointer: pointer.to_owned(), kind: FindingKind::Violation, message: message.into() });
    }

    #[allow(dead_code)]
    fn unevaluated(&mut self, pointer: &str, message: impl Into<String>) {
        self.findings.push(Finding { pointer: pointer.to_owned(), kind: FindingKind::Unevaluated, message: message.into() });
    }
}

/// Checks a value against the constraints its schema declares that its
/// type cannot express.
pub trait Validate {
    fn validate(&self) -> ValidationReport {
        let mut report = ValidationReport::default();
        self.validate_into("", &mut report);
        report
    }

    /// Adds the findings for this value, found at `pointer`, to `report`.
    fn validate_into(&self, pointer: &str, report: &mut ValidationReport);
}

impl<T: Validate> Validate for Vec<T> {
    fn validate_into(&self, pointer: &str, report: &mut ValidationReport) {
        for (i, item) in self.iter().enumerate() {
            item.validate_into(&child_pointer(pointer, &i.to_string()), report);
        }
    }
}

impl<T: Validate> Validate for Option<T> {
    fn validate_into(&self, pointer: &str, report: &mut ValidationReport) {
        if let Some(value) = self {
            value.validate_into(pointer, report);
        }
    }
}

impl<T: Validate> Validate for Box<T> {
    fn validate_into(&self, pointer: &str, report: &mut ValidationReport) {
        (**self).validate_into(pointer, report);
    }
}

impl<T: Validate> Validate for std::collections::BTreeMap<String, T> {
    fn validate_into(&self, pointer: &str, report: &mut ValidationReport) {
        for (key, value) in self {
            value.validate_into(&child_pointer(pointer, key), report);
        }
    }
}

/// `pointer` extended by one RFC 6901 reference token.
fn child_pointer(pointer: &str, token: &str) -> String {
    format!("{pointer}/{}", token.replace('~', "~0").replace('/', "~1"))
}

