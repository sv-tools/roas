{% endif %}{% if support.string_only %}/// Hands a string enum's derived code the same deserializer, asked for a
/// JSON string only: serde's derive would also read `{"a": null}` as `"a"`.
/// Unused when every string enum is compiled out.
#[allow(dead_code, non_camel_case_types)]
struct roas_string_only<D>(D);

impl<'de, D: serde::Deserializer<'de>> serde::Deserializer<'de> for roas_string_only<D> {
    type Error = D::Error;

    fn deserialize_any<V: serde::de::Visitor<'de>>(self, visitor: V) -> Result<V::Value, D::Error> {
        self.0.deserialize_any(visitor)
    }

    fn deserialize_enum<V: serde::de::Visitor<'de>>(
        self,
        _name: &'static str,
        _variants: &'static [&'static str],
        visitor: V,
    ) -> Result<V::Value, D::Error> {
        self.0.deserialize_str(roas_string_only_variant(visitor))
    }

    fn is_human_readable(&self) -> bool {
        self.0.is_human_readable()
    }

    serde::forward_to_deserialize_any! {
        bool i8 i16 i32 i64 i128 u8 u16 u32 u64 u128 f32 f64 char str string
        bytes byte_buf option unit unit_struct newtype_struct seq tuple
        tuple_struct map struct identifier ignored_any
    }
}

/// Reads the variant a JSON string names.
#[allow(dead_code, non_camel_case_types)]
struct roas_string_only_variant<V>(V);

impl<'de, V: serde::de::Visitor<'de>> serde::de::Visitor<'de> for roas_string_only_variant<V> {
    type Value = V::Value;

    fn expecting(&self, formatter: &mut std::fmt::Formatter) -> std::fmt::Result {
        self.0.expecting(formatter)
    }

    fn visit_str<E: serde::de::Error>(self, value: &str) -> Result<V::Value, E> {
        self.0.visit_enum(serde::de::value::StrDeserializer::new(value))
    }

    fn visit_string<E: serde::de::Error>(self, value: String) -> Result<V::Value, E> {
        self.0.visit_enum(serde::de::value::StringDeserializer::new(value))
    }
}

