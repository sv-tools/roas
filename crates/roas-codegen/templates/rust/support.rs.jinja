    }
}

{% endif %}{% if support.catch_all %}/// Hands a struct's derived code the same deserializer, asked for a JSON
/// object, with only the members `declared` names: the rest, when `allowed`
/// lets them in, decode into `rest` straight from the deserializer, which
/// still has their raw tokens; any other member is refused.
/// Unused when every struct with a catch-all is compiled out.
#[allow(dead_code, non_camel_case_types)]
struct roas_catch_all<'r, D, T> {
    inner: D,
    declared: fn(&str) -> bool,
    /// Whether a member no field reads is let in.
    allowed: fn(&str) -> bool,
    rest: &'r mut std::collections::BTreeMap<String, T>,
}

impl<'de, D: serde::Deserializer<'de>, T: serde::Deserialize<'de>> serde::Deserializer<'de> for roas_catch_all<'_, D, T> {
    type Error = D::Error;

    fn deserialize_any<V: serde::de::Visitor<'de>>(self, visitor: V) -> Result<V::Value, D::Error> {
        self.inner.deserialize_map(roas_catch_all { inner: visitor, declared: self.declared, allowed: self.allowed, rest: self.rest })
    }

    fn is_human_readable(&self) -> bool {
        self.inner.is_human_readable()
    }

    serde::forward_to_deserialize_any! {
        bool i8 i16 i32 i64 i128 u8 u16 u32 u64 u128 f32 f64 char str string
        bytes byte_buf option unit unit_struct newtype_struct seq tuple
        tuple_struct map struct enum identifier ignored_any
    }
}

impl<'de, V: serde::de::Visitor<'de>, T: serde::Deserialize<'de>> serde::de::Visitor<'de> for roas_catch_all<'_, V, T> {
    type Value = V::Value;

    fn expecting(&self, formatter: &mut std::fmt::Formatter) -> std::fmt::Result {
        self.inner.expecting(formatter)
    }

    fn visit_map<A: serde::de::MapAccess<'de>>(self, map: A) -> Result<V::Value, A::Error> {
        self.inner.visit_map(roas_catch_all { inner: map, declared: self.declared, allowed: self.allowed, rest: self.rest })
    }
}

impl<'de, A: serde::de::MapAccess<'de>, T: serde::Deserialize<'de>> serde::de::MapAccess<'de> for roas_catch_all<'_, A, T> {
    type Error = A::Error;

    fn next_key_seed<K: serde::de::DeserializeSeed<'de>>(&mut self, seed: K) -> Result<Option<K::Value>, A::Error> {
        while let Some(key) = self.inner.next_key::<String>()? {
            if (self.declared)(&key) {
                return seed.deserialize(serde::de::value::StringDeserializer::<A::Error>::new(key)).map(Some);
            }
            if !(self.allowed)(&key) {
                return Err(serde::de::Error::custom(format!("unknown field `{key}`: it matches no property and no pattern")));
            }
            let value = self.inner.next_value::<T>()?;
            self.rest.insert(key, value);
        }
        Ok(None)
    }

    fn next_value_seed<S: serde::de::DeserializeSeed<'de>>(&mut self, seed: S) -> Result<S::Value, A::Error> {
        self.inner.next_value_seed(seed)
    }
}

