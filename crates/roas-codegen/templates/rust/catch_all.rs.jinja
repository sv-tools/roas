{% block catch_all %}
// The derived code is inherent (`remote = "Self"`); these impls hand it
// the declared members only, and decode the rest into the catch-all as
// they stream by: serde's `flatten` would buffer them, and an integer or
// a raw holder cannot be read from the buffer. A deprecated type is
// still implemented.
{% for a in t.cfg %}{{ a }}
{% endfor %}#[allow(deprecated)]
impl serde::Serialize for {{ t.name }} {
    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
        Self::serialize(self, serializer)
    }
}

{% for a in t.cfg %}{{ a }}
{% endfor %}#[allow(deprecated, clippy::match_like_matches_macro, clippy::match_single_binding)]
impl<'de> serde::Deserialize<'de> for {{ t.name }} {
    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
        let mut rest = std::collections::BTreeMap::new();
        let mut value = Self::deserialize(roas_catch_all {
            inner: deserializer,
            declared: |name: &str| match name {
{% for d in t.catch_all.declared %}{% for a in d.cfg %}                {{ a }}
{% endfor %}                {{ d.names }} => true,
{% endfor %}                _ => false,
            },
            rest: &mut rest,
        })?;
        value.{{ t.catch_all.field }} = rest;
        Ok(value)
    }
}
